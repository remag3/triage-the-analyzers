<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs project decisions: a rule, or a rule in part of the code, that the team has decided not
     to enforce. One Match per decision, with a comment giving the reason.

     Unlike the baseline, this file may grow, but every entry is a reviewed decision. -->
<FindBugsFilter>
    <!-- D1: EI_EXPOSE_REP and EI_EXPOSE_REP2:
         Project Pulse is a Spring Boot application using Jakarta Persistence (JPA/Hibernate).
         JPA entities share mutable domain model references and persistent collections by design;
         defensive copying breaks entity identity, dirty tracking, and Hibernate proxy associations.
         Furthermore, Spring controller and service components use constructor dependency injection,
         storing framework-managed singleton bean references. Enforcing defensive copying across
         these classes conflicts with the architectural design of Spring Boot and JPA. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
