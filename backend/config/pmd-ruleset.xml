<?xml version="1.0" encoding="UTF-8"?>
<!-- PMD rules for Project Pulse: PMD's quickstart set, minus the rules the team has decided not to
     enforce. To drop a rule, add an exclude inside the quickstart reference, with a comment giving
     the reason, for example:

       <exclude name="ControlStatementBraces"/>

     To add a rule from outside quickstart, add its own <rule ref="category/java/..."/> line.
     Every change here is a reviewed decision. -->
<ruleset name="Project Pulse"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>PMD quickstart, with Project Pulse's decisions.</description>
    <rule ref="rulesets/java/quickstart.xml">
        <!-- D2: UncommentedEmptyConstructor and UnnecessaryConstructor:
             JPA entities require a public or protected no-argument constructor for reflective
             instantiation. Forcing boilerplate comments inside every required constructor
             (UncommentedEmptyConstructor) creates noise without value, and UnnecessaryConstructor
             flags explicit no-arg constructors required for JPA/JSON serialization or framework clarity. -->
        <exclude name="UncommentedEmptyConstructor"/>
        <exclude name="UnnecessaryConstructor"/>

        <!-- D3: ControlStatementBraces:
             The codebase intentionally uses single-line guard clauses (e.g., "if (x == null) return null;")
             for early-exit conditions in converters, utility methods, and domain entities. Requiring
             braces on every single-line guard clause adds unnecessary vertical whitespace without
             improving readability. -->
        <exclude name="ControlStatementBraces"/>

        <!-- D4: GuardLogStatement:
             The project uses SLF4J parameterized logging ("{}"), which avoids string concatenation
             and formatting overhead when the log level is disabled. Forcing guards like
             "if (LOGGER.isDebugEnabled())" around parameterized log statements introduces redundant
             boilerplate without performance benefit. -->
        <exclude name="GuardLogStatement"/>
    </rule>
</ruleset>
